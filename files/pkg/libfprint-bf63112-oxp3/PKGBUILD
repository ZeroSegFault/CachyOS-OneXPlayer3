# Local build for the OneXPlayer 3 postinstall (CachyOS-OneXPlayer3).
# libfprint 1.94.100 + the BF63112 SPI driver, side-installed for fprintd only:
# the distro libfprint stays in place and nothing else loads this copy.
pkgname=libfprint-bf63112-oxp3
_commit=6a19d67d2a072dac4b6a467434966c55af76b602
pkgver=1.94.100.r8.g6a19d67
pkgrel=1
pkgdesc="libfprint with the Betterlife BF63112 driver for the ONEXPLAYER 3 (fprintd side-install)"
arch=(x86_64)
url="https://github.com/pythontyphon/libfprint-bf63112-oxp3"
license=(LGPL-2.1-or-later)
options=(!debug)
depends=(
  fprintd
  glib2
  glibc
  libgcc
  libgudev
  libgusb
  libstdc++
  opencv
)
makedepends=(
  git
  glib2-devel
  meson
  patchelf
)
source=(
  "libfprint::git+https://github.com/pythontyphon/libfprint-bf63112-oxp3.git#commit=$_commit"
  0001-sigfm-Validate-stored-templates-before-deserializing.patch
  0002-sigfm-Count-only-distinct-correspondences-as-RANSAC-.patch
  0003-bf63112-Allow-only-stricter-thresholds-from-the-envi.patch
  0004-bf63112-Retry-instead-of-failing-on-sensor-timeouts-.patch
  0005-image-device-Skip-enrolled-prints-a-custom-matcher-c.patch
  0006-tests-Cover-corrupt-BF63112-templates-and-threshold-.patch
  0007-build-Fix-the-skipped-driver-tests-when-introspectio.patch
)
