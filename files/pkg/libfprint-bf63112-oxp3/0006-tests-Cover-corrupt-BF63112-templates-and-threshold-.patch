From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: oxp3 <oxp3@localhost>
Date: Wed, 7 Oct 2026 21:34:57 +1100
Subject: [PATCH 6/7] tests: Cover corrupt BF63112 templates and threshold
 clamping

---
 tests/test-bf63112-sigfm.c | 59 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 59 insertions(+)

diff --git a/tests/test-bf63112-sigfm.c b/tests/test-bf63112-sigfm.c
index 92ff526..9de04a2 100644
--- a/tests/test-bf63112-sigfm.c
+++ b/tests/test-bf63112-sigfm.c
@@ -21,6 +21,7 @@
 #include "fpi-print.h"
 #include "fpi-device.h"
 #include "drivers/bf63112-sigfm.h"
+#include "sigfm/sigfm.hpp"
 
 /* Real fingerprints are biometric data and cannot be shipped with the tests;
  * a smoothed random texture gives SIFT the same kind of dense local structure.
@@ -224,6 +225,58 @@ test_foreign_data_is_rejected (void)
   g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
 }
 
+static void
+test_truncated_template_is_rejected (void)
+{
+  g_autofree guint8 *finger = make_texture (5);
+  g_autoptr(FpPrint) enrolled = enroll (finger);
+  g_autoptr(FpImage) image = crop (finger, 30, 20);
+  g_autoptr(FpPrint) probe = print_from_image (image, CHIP_ID);
+  g_autoptr(FpPrint) corrupt = new_print ();
+  g_autoptr(GVariant) value = NULL;
+  g_autoptr(GVariant) samples = NULL;
+  g_autoptr(GVariant) sample = NULL;
+  GVariant *truncated[1];
+  guint32 schema;
+  guint16 chip_id, width, height;
+  const guint8 *bytes;
+  gsize len;
+  GError *error = NULL;
+
+  g_object_get (enrolled, "fpi-data", &value, NULL);
+  g_variant_get (value, "(uqqq@aay)", &schema, &chip_id, &width, &height, &samples);
+  sample = g_variant_get_child_value (samples, 0);
+  bytes = g_variant_get_fixed_array (sample, &len, 1);
+  g_assert_cmpuint (len, >, 64);
+
+  /* Keep the headers but drop the end of the descriptor data */
+  truncated[0] = g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, bytes, len - 64, 1);
+  g_object_set (corrupt, "fpi-data",
+                g_variant_new ("(uqqq@aay)", schema, chip_id, width, height,
+                               g_variant_new_array (G_VARIANT_TYPE ("ay"), truncated, 1)),
+                NULL);
+
+  g_assert_cmpint (bf63112_sigfm_match (corrupt, probe, bf63112_sigfm_get_threshold (),
+                                        NULL, &error), ==, FPI_MATCH_ERROR);
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+  g_clear_error (&error);
+}
+
+static void
+test_oversized_header_is_rejected (void)
+{
+  /* No keypoints, then a 1000x128 CV_32FC1 (type 5) header with 16 bytes */
+  guint8 blob[sizeof (gsize) + 3 * sizeof (gint32) + 16] = { 0 };
+  gint32 header[3] = { 5, 1000, 128 };
+
+  memcpy (blob + sizeof (gsize), header, sizeof (header));
+  g_assert_null (sigfm_deserialize_binary (blob, sizeof (blob)));
+
+  /* A keypoint count far beyond the data */
+  memset (blob, 0xff, sizeof (gsize));
+  g_assert_null (sigfm_deserialize_binary (blob, sizeof (blob)));
+}
+
 static void
 test_threshold_override (void)
 {
@@ -237,6 +290,10 @@ test_threshold_override (void)
 
   g_setenv ("LIBFPRINT_BF63112_RANSAC_THRESHOLD", "12", TRUE);
   g_assert_cmpint (bf63112_sigfm_get_ransac_threshold (), ==, 12);
+  g_setenv ("LIBFPRINT_BF63112_RANSAC_THRESHOLD", "2", TRUE);
+  g_test_expect_message ("libfprint-bf63112", G_LOG_LEVEL_WARNING, "*below the default*");
+  g_assert_cmpint (bf63112_sigfm_get_ransac_threshold (), ==, BF63112_RANSAC_DEFAULT_THRESHOLD);
+  g_test_assert_expected_messages ();
   g_unsetenv ("LIBFPRINT_BF63112_RANSAC_THRESHOLD");
   g_assert_cmpint (bf63112_sigfm_get_ransac_threshold (), ==, BF63112_RANSAC_DEFAULT_THRESHOLD);
 }
@@ -251,6 +308,8 @@ main (int argc, char *argv[])
   g_test_add_func ("/bf63112-sigfm/serialized-template-matches", test_serialized_template_matches);
   g_test_add_func ("/bf63112-sigfm/other-chip-does-not-match", test_other_chip_does_not_match);
   g_test_add_func ("/bf63112-sigfm/foreign-data-is-rejected", test_foreign_data_is_rejected);
+  g_test_add_func ("/bf63112-sigfm/truncated-template-is-rejected", test_truncated_template_is_rejected);
+  g_test_add_func ("/bf63112-sigfm/oversized-header-is-rejected", test_oversized_header_is_rejected);
   g_test_add_func ("/bf63112-sigfm/threshold-override", test_threshold_override);
 
   return g_test_run ();
