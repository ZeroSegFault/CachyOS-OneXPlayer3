[Unit]
Description=OneXPlayer 3 battery charge limit for Steam
After=dbus.service systemd-modules-load.service

[Service]
Type=dbus
BusName=local.oxp3.ChargeLimit
ExecStart=/usr/lib/oxp3/oxp3-charge-limit
Restart=on-failure
RestartSec=3
ProtectSystem=strict
ReadWritePaths=/sys/class/power_supply/BAT0/charge_control_end_threshold
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
